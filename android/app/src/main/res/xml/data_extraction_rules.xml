<?xml version="1.0" encoding="utf-8"?>
<!--
  Oceans Symphony is local-first and privacy-first: the user's data (an
  IndexedDB blob that may be encrypted with THEIR passphrase) must never be
  copied off-device by the OS without their knowledge. Android's cloud
  backup / device-to-device transfer would do exactly that (and can restore
  STALE data over fresh data on a new phone). The app has its own explicit,
  health-checked backup system (Settings → Data & privacy → Backup) — that
  is the one sanctioned way data leaves the device.
  Both cloud-backup and device-transfer are excluded entirely (API 31+);
  android:allowBackup="false" covers older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
